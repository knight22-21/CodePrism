# CodePrism benchmark environment variables
# Copy this file to .env and fill in your keys.
# .env is gitignored — never commit the real keys.

# ── Ollama cloud (https://ollama.com) ────────────────────────────────────────
OLLAMA_API_KEY=your-ollama-api-key-here
OLLAMA_BASE_URL=https://ollama.com/v1

# Model to use as LLM-as-judge (run: python -m benchmarks.list_models to see options)
# gpt-oss:120b  — best judgment quality (recommended)
# deepseek-v4-pro:0813  — fallback if gpt-oss gives inconsistent results
# deepseek-v4.1-flash   — high-volume / cheap runs only
BENCHMARK_JUDGE_MODEL=gpt-oss:120b

# ── Token counting backend ───────────────────────────────────────────────────
# auto = tiktoken if installed, else word-approx (no key needed)
# claude = exact Claude tokens via Anthropic API (requires ANTHROPIC_API_KEY)
BENCHMARK_TOKEN_BACKEND=auto

# ── Anthropic (optional — only needed if using Claude token counting) ────────
ANTHROPIC_API_KEY=

# ── Accuracy eval ────────────────────────────────────────────────────────────
# Set to 1 to skip accuracy eval and only measure token counts
BENCHMARK_SKIP_ACCURACY=0
